        <!-- Simulator Result Metrics -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6 pt-6 border-t border-white/10 font-mono text-center">
          <div class="p-3 rounded-2xl bg-white/[0.02]">
            <span class="text-[10px] text-stucco uppercase block">Cash Liberated</span>
            <span class="text-xl sm:text-2xl font-bold text-acid mt-1 block tabular-nums" id="sim-cash-recovered">₹38,200</span>
          </div>
          <div class="p-3 rounded-2xl bg-white/[0.02]">
            <span class="text-[10px] text-stucco uppercase block">Velocity Multiplier</span>
            <span class="text-xl sm:text-2xl font-bold text-white mt-1 block tabular-nums" id="sim-velocity-mult">2.45x</span>
          </div>
          <div class="p-3 rounded-2xl bg-white/[0.02]">
            <span class="text-[10px] text-stucco uppercase block">Days to Clear</span>
            <span class="text-xl sm:text-2xl font-bold text-emerald mt-1 block tabular-nums" id="sim-days-to-clear">18 Days</span>
          </div>
          <div class="p-3 rounded-2xl bg-white/[0.02]">
            <span class="text-[10px] text-stucco uppercase block">Warehouse Space</span>
            <span class="text-xl sm:text-2xl font-bold text-white mt-1 block tabular-nums" id="sim-space-freed">+34% Free</span>
          </div>
        </div>

        <div class="mt-6 flex justify-end">
          <button id="sim-execute-all-btn" class="btn-acid px-6 py-2.5 rounded-xl text-xs flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">bolt</span>
            <span>Execute Optimal 15% Clearance Across Store</span>
          </button>
        </div>
      </div>

      <!-- Interactive SKU Matrix & Catalog Controls -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <!-- Status Filter Chips -->
        <div class="flex flex-wrap items-center gap-2" id="status-chips">
          <button class="status-chip px-3.5 py-1.5 rounded-xl font-mono text-xs font-semibold bg-acid text-obsidian" data-status="all">
            All SKUs (<span id="count-all">412</span>)
          </button>
          <button class="status-chip px-3.5 py-1.5 rounded-xl font-mono text-xs text-stucco hover:text-white bg-white/5" data-status="dead">
            Dead Stock (<span id="count-dead">49</span>)
          </button>
          <button class="status-chip px-3.5 py-1.5 rounded-xl font-mono text-xs text-stucco hover:text-white bg-white/5" data-status="risk">
            Slow Risk (<span id="count-risk">32</span>)
          </button>
          <button class="status-chip px-3.5 py-1.5 rounded-xl font-mono text-xs text-stucco hover:text-white bg-white/5" data-status="low">
            Stockout Alert (<span id="count-low">74</span>)
          </button>
          <button class="status-chip px-3.5 py-1.5 rounded-xl font-mono text-xs text-stucco hover:text-white bg-white/5" data-status="healthy">
            Healthy (<span id="count-healthy">255</span>)
          </button>
        </div>

        <!-- Search Bar -->
        <div class="relative w-full md:w-72">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-stucco text-lg">search</span>
          <input type="text" id="sku-search-input" placeholder="Search SKU, item, supplier..." class="w-full bg-white/5 border border-white/10 rounded-xl pl-10 pr-4 py-2 text-xs text-white placeholder-stucco focus:outline-none focus:border-acid transition-colors font-mono">
        </div>
      </div>

      <!-- Live SKU Catalog Grid (Dynamic Render Target) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="sku-grid-container">
        <!-- Injected via JavaScript from window.Mercura.catalog() -->
      </div>

      <!-- Pagination / Load More Bar -->
      <div class="flex items-center justify-between py-6 mt-8 border-t border-white/10 font-mono text-xs text-stucco">
        <span id="pagination-status">Showing 12 of 412 SKUs</span>
        <div class="flex items-center gap-2">
          <button id="prev-page-btn" class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-white disabled:opacity-30 disabled:cursor-not-allowed">
            Previous
          </button>
          <span id="page-num-display" class="px-3 py-1 font-bold text-white">1</span>
          <button id="next-page-btn" class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-white disabled:opacity-30 disabled:cursor-not-allowed">
            Next
          </button>
        </div>
      </div>

    </div>
  </section>


  <!-- =========================================================================
       SKU INTELLIGENCE MODAL / SLIDE-IN GLASS DRAWER
       ========================================================================= -->
  <div id="sku-drawer" class="fixed inset-0 z-50 pointer-events-none transition-all duration-300 opacity-0">
    <!-- Backdrop blur -->
    <div class="absolute inset-0 bg-obsidian/70 backdrop-blur-md drawer-backdrop"></div>
    
    <!-- Drawer Panel -->
    <div class="absolute top-0 right-0 bottom-0 w-full max-w-xl bg-obsidian/95 border-l border-white/15 p-6 sm:p-8 overflow-y-auto flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-out drawer-panel shadow-2xl">
      <div>
        <div class="flex items-center justify-between pb-6 border-b border-white/10">
          <div class="flex items-center gap-3">
            <span class="px-2.5 py-1 rounded bg-acid text-obsidian font-mono font-bold text-xs" id="d-sku-code">#SKU-000</span>
            <span class="text-xs text-stucco uppercase font-mono" id="d-sku-cat">Category</span>
          </div>
          <button id="drawer-close-btn" class="p-2 rounded-xl bg-white/5 hover:bg-white/10 text-stucco hover:text-white transition-colors">
            <span class="material-symbols-outlined text-lg">close</span>
          </button>
        </div>

        <!-- Product Hero in Drawer -->
        <div class="flex items-start gap-5 my-6">
          <img id="d-sku-img" src="img/jacket.jpg" alt="Product" class="w-20 h-20 rounded-2xl object-cover border border-white/20">
          <div>
            <h3 id="d-sku-name" class="font-display font-bold text-2xl text-white">Product Name</h3>
            <p id="d-sku-supplier" class="text-xs text-stucco font-medium mt-1">Supplier Name</p>
            <div class="mt-2 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-bold" id="d-sku-status-pill">
              STATUS
            </div>
          </div>
        </div>

        <!-- Channel Distribution Bar -->
        <div class="mb-6 p-4 rounded-2xl bg-white/[0.03] border border-white/5 space-y-3">
          <span class="text-[11px] font-mono text-stucco uppercase tracking-wider block">Channel Stock Allocation</span>
          <div class="grid grid-cols-3 gap-2 text-center font-mono">
            <div class="p-2 rounded-xl bg-white/5">
              <span class="text-[10px] text-stucco block">Shopify</span>
              <span class="font-bold text-white text-sm" id="d-channel-shopify">0 units</span>
            </div>
            <div class="p-2 rounded-xl bg-white/5">
              <span class="text-[10px] text-stucco block">Offline POS</span>
              <span class="font-bold text-white text-sm" id="d-channel-pos">0 units</span>
            </div>
            <div class="p-2 rounded-xl bg-white/5">
              <span class="text-[10px] text-stucco block">Warehouse</span>
              <span class="font-bold text-white text-sm" id="d-channel-warehouse">0 units</span>
            </div>
          </div>
        </div>

        <!-- Financial Breakdown Matrix -->
        <div class="grid grid-cols-2 gap-4 mb-6 font-mono">
          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
            <span class="text-[10px] text-stucco uppercase block">Total Units</span>
            <span class="text-xl font-bold text-white mt-1 block" id="d-sku-units">0</span>
          </div>
          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
            <span class="text-[10px] text-stucco uppercase block">Inventory Value</span>
            <span class="text-xl font-bold text-white mt-1 block" id="d-sku-value">₹0</span>
          </div>
          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
            <span class="text-[10px] text-stucco uppercase block">Retail Price</span>
            <span class="text-xl font-bold text-white mt-1 block" id="d-sku-price">₹0</span>
          </div>
          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
            <span class="text-[10px] text-stucco uppercase block">Sales Velocity</span>
            <span class="text-xl font-bold text-white mt-1 block" id="d-sku-velocity">0 /wk</span>
          </div>
        </div>

        <!-- AI Prescriptive Recommendation in Drawer -->
        <div class="p-5 rounded-2xl bg-acid/10 border border-acid/20 space-y-2 mb-6">
          <div class="flex items-center gap-1.5 text-acid font-bold text-xs uppercase font-mono">
            <span class="material-symbols-outlined text-sm">auto_awesome</span>
            <span>Mercura Autonomous Strategy</span>
          </div>
          <p id="d-sku-ai-note" class="text-xs text-white/90 leading-relaxed font-sans">
            AI analysis loading...
          </p>
        </div>
      </div>

      <!-- Drawer Bottom Action Buttons -->
      <div class="pt-6 border-t border-white/10 space-y-3">
        <button id="d-action-clearance-btn" class="w-full btn-acid py-3 rounded-xl text-xs flex items-center justify-center gap-2">
          <span class="material-symbols-outlined text-base">bolt</span>
          <span>Execute Clearance Discount</span>
        </button>
        <button id="d-action-reorder-btn" class="w-full btn-frosted py-2.5 rounded-xl text-xs flex items-center justify-center gap-2">
          <span class="material-symbols-outlined text-base">content_copy</span>
          <span>Copy Supplier Order Note</span>
        </button>
      </div>
    </div>
  </div>


  <!-- =========================================================================
       EDITORIAL TOAST NOTIFICATION CONTAINER
       ========================================================================= -->
  <div id="editorial-toast" class="editorial-toast">
    <span class="material-symbols-outlined text-acid text-xl" id="toast-icon">bolt</span>
    <span id="toast-msg">Action completed successfully.</span>
  </div>


  <!-- =========================================================================
       FOOTER
       ========================================================================= -->
  <footer class="py-16 px-4 sm:px-6 lg:px-12 bg-obsidian text-white border-t border-white/10 font-mono text-xs">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <div class="w-7 h-7 rounded-lg bg-acid flex items-center justify-center text-obsidian font-display font-extrabold text-xs">
          M
        </div>
        <span class="font-display font-bold text-sm tracking-tight text-white">MERCURA AI</span>
        <span class="text-stucco">// TASTE SKILL 2.0 EDITORIAL FINTECH</span>
      </div>
      <div class="flex items-center gap-6 text-stucco">
        <a href="#scale-hero" class="hover:text-acid transition-colors">Hero</a>
        <a href="#ghost-numerals" class="hover:text-acid transition-colors">Numerals</a>
        <a href="#glass-cards" class="hover:text-acid transition-colors">Glass Cards</a>
        <a href="#live-terminal" class="hover:text-acid transition-colors">Live Terminal</a>
        <a href="dashboard.html" class="hover:text-white transition-colors">Standalone App ↗</a>
      </div>
      <p class="text-stucco/60">
        Engineered for High-Velocity Merchants. © 2026 Mercura.
      </p>
    </div>
  </footer>


  <!-- =========================================================================
       CORE ENGINE & APPLICATION LOGIC
       ========================================================================= -->
  <script src="engine.js"></script>
  <script src="nav.js"></script>

  <script>
    (function() {
      const M = window.Mercura;
      const STORAGE_KEY = "mercura-ledger-v1";
      
      // State
      let actions = (function() {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY)) || M.emptyActions();
        } catch(e) {
          return M.emptyActions();
        }
      })();

      let currentChannel = "all";
      let currentStatus = "all";
      let searchQuery = "";
      let currentPage = 1;
      const pageSize = 9;
      let activeDrawerSku = null;

      function persist() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(actions));
      }

      function showToast(msg, icon = 'bolt') {
        const toast = document.getElementById('editorial-toast');
        const toastMsg = document.getElementById('toast-msg');
        const toastIcon = document.getElementById('toast-icon');
        if (!toast) return;
        toastMsg.textContent = msg;
        toastIcon.textContent = icon;
        toast.classList.add('active');
        clearTimeout(showToast._timer);
        showToast._timer = setTimeout(() => {
          toast.classList.remove('active');
        }, 3600);
      }

      function fireConfetti() {
        if (typeof confetti === 'function') {
          confetti({
            particleCount: 80,
            spread: 60,
            origin: { y: 0.8 },
            colors: ['#E8FF00', '#FFFFFF', '#00C853']
          });
        }
      }

      // Initialize Lenis Smooth Scroll
      if (typeof Lenis !== 'undefined') {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          direction: 'vertical',
          gestureDirection: 'vertical',
          smooth: true,
          smoothTouch: false,
          touchMultiplier: 2
        });

        function raf(time) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // GSAP ScrollTrigger Integration
        if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
          gsap.registerPlugin(ScrollTrigger);
          lenis.on('scroll', ScrollTrigger.update);
          gsap.ticker.add((time) => {
            lenis.raf(time * 1000);
          });
          gsap.ticker.lagSmoothing(0);
        }
      }

      // Interactive 3D Perspective Tilt on Mouse Movement for Hero "Scale."
      const scaleBox = document.getElementById('scale-interactive-box');
      if (scaleBox) {
        const tiltHeading = scaleBox.querySelector('.perspective-tilt');
        scaleBox.addEventListener('mousemove', (e) => {
          const rect = scaleBox.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;
          tiltHeading.style.transform = `perspective(1000px) rotateY(${-18 + x * 20}deg) rotateX(${4 - y * 16}deg)`;
        });
        scaleBox.addEventListener('mouseleave', () => {
          tiltHeading.style.transform = `perspective(1000px) rotateY(-18deg) rotateX(4deg)`;
        });
      }

      // Sound Toggle Button
      const soundBtn = document.getElementById('sound-toggle-btn');
      if (soundBtn) {
        soundBtn.addEventListener('click', () => {
          const isMuted = HapticAudio.toggleMute();
          soundBtn.innerHTML = `<span class="material-symbols-outlined text-[18px]">${isMuted ? 'volume_off' : 'volume_up'}</span>`;
          if (!isMuted) HapticAudio.click(900);
          showToast(isMuted ? "Audio Haptics Muted" : "Audio Haptics Enabled 🔊", isMuted ? "volume_off" : "volume_up");
        });
      }

      // Global click listener for tactile audio
      document.addEventListener('click', (e) => {
        if (e.target.closest('button, a, input[type="range"]')) {
          HapticAudio.click(1100);
        }
      });

      // Recalculate and render KPIs
      function updateKPIs() {
        const list = M.catalog(actions);
        const k = M.kpis(list, currentChannel);

        // HUD Elements
        const hudTotal = document.getElementById('hud-total-val');
        const hudRisk = document.getElementById('hud-risk-val');
        if (hudTotal) hudTotal.textContent = M.inr(k.inventoryValue);
        if (hudRisk) hudRisk.textContent = `${M.inr(k.capital)} AT RISK`;

        // Terminal KPI Tiles
        const kpiInv = document.getElementById('kpi-inventory-val');
        const kpiRisk = document.getElementById('kpi-risk-val');
        const kpiSales = document.getElementById('kpi-sales-val');
        const kpiRec = document.getElementById('kpi-recoverable-val');
        const kpiSkuCount = document.getElementById('kpi-sku-count');
        const kpiRiskCount = document.getElementById('kpi-risk-count');

        if (kpiInv) kpiInv.textContent = M.inr(k.inventoryValue);
        if (kpiRisk) kpiRisk.textContent = M.inr(k.capital);
        if (kpiSales) kpiSales.textContent = M.inr(k.sales);
        if (kpiRec) kpiRec.textContent = M.inr(Math.round(k.capital * 0.78));
        if (kpiSkuCount) kpiSkuCount.textContent = `${k.total} SKUs active`;
        if (kpiRiskCount) kpiRiskCount.textContent = `${k.dead + k.risk} SKUs slow/dead`;

        // Filter Counts
        const cAll = document.getElementById('count-all');
        const cDead = document.getElementById('count-dead');
        const cRisk = document.getElementById('count-risk');
        const cLow = document.getElementById('count-low');
        const cHealthy = document.getElementById('count-healthy');

        if (cAll) cAll.textContent = k.total;
        if (cDead) cDead.textContent = k.dead;
        if (cRisk) cRisk.textContent = k.risk;
        if (cLow) cLow.textContent = k.low;
        if (cHealthy) cHealthy.textContent = k.healthy;

        // Card 1 JKT-409 state sync
        const jacket = list.find(s => s.id === "JKT-409");
        if (jacket) {
          const jktStatus = document.getElementById('jkt-status-badge');
          const jktPrice = document.getElementById('jkt-locked-price');
          const jktBtn = document.getElementById('jkt-apply-promo-btn');
          const jktLockBtn = document.getElementById('jkt-lock-reorder-btn');
          
          if (jacket.clearance > 0) {
            if (jktStatus) {
              jktStatus.className = "flex items-center justify-between py-2 px-3 rounded-xl bg-acid/15 border border-acid/30 text-acid text-xs font-mono font-bold mb-5";
              jktStatus.innerHTML = `<div class="flex items-center gap-2"><span class="pulse-beacon-acid"></span><span>15% CLEARANCE ACTIVE</span></div><span>PROMO LIVE</span>`;
            }
            if (jktPrice) jktPrice.textContent = M.inr(jacket.value);
            if (jktBtn) {
              jktBtn.innerHTML = `<span class="material-symbols-outlined text-base">check_circle</span><span>15% Clearance Running</span>`;
              jktBtn.classList.remove('btn-acid');
              jktBtn.classList.add('bg-acid/20', 'text-acid', 'border', 'border-acid/40');
            }
          }
          if (jacket.locked && jktLockBtn) {
            jktLockBtn.innerHTML = `<span class="material-symbols-outlined text-base">lock</span><span>Reorders Locked 🔒</span>`;
            jktLockBtn.classList.add('border-acid/50', 'text-acid');
          }
        }
      }

      // Render SKU Matrix Cards
      function renderCatalog() {
        const list = M.catalog(actions);
        const filtered = list.filter(sku => {
          // Channel check
          if (currentChannel !== "all" && !(sku.channels[currentChannel] > 0)) return false;
          // Status check
          if (currentStatus === "dead" && sku.status !== "dead") return false;
          if (currentStatus === "risk" && sku.status !== "risk") return false;
          if (currentStatus === "low" && (sku.status !== "low" && sku.status !== "critical")) return false;
          if (currentStatus === "healthy" && sku.status !== "healthy") return false;
          // Search check
          if (searchQuery) {
            const q = searchQuery.toLowerCase();
            const text = (sku.id + " " + sku.name + " " + sku.cat + " " + sku.supplier).toLowerCase();
            if (!text.includes(q)) return false;
          }
          return true;
        });

        const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;

        const startIdx = (currentPage - 1) * pageSize;
        const pageItems = filtered.slice(startIdx, startIdx + pageSize);

        const container = document.getElementById('sku-grid-container');
        if (!container) return;

        if (pageItems.length === 0) {
          container.innerHTML = `
            <div class="col-span-full py-16 text-center text-stucco font-mono text-sm">
              <span class="material-symbols-outlined text-4xl mb-2 text-white/30">search_off</span>
              <p>No inventory items found matching your filters.</p>
            </div>
          `;
          return;
        }

        container.innerHTML = pageItems.map(sku => {
          const isDead = sku.status === "dead";
          const isRisk = sku.status === "risk";
          const isLow = sku.status === "low" || sku.status === "critical";
          const glowClass = isDead ? "card-glow-risk" : (isLow ? "card-glow-acid" : "");
          
          let statusBadge = "";
          if (isDead) {
            statusBadge = `<span class="px-2 py-0.5 rounded bg-crimson/15 text-crimson font-mono text-[10px] font-bold border border-crimson/30">DEAD STOCK</span>`;
          } else if (isRisk) {
            statusBadge = `<span class="px-2 py-0.5 rounded bg-amber/15 text-amber font-mono text-[10px] font-bold border border-amber/30">SLOW RISK</span>`;
          } else if (isLow) {
            statusBadge = `<span class="px-2 py-0.5 rounded bg-acid/15 text-acid font-mono text-[10px] font-bold border border-acid/30">LOW STOCK</span>`;
          } else {
            statusBadge = `<span class="px-2 py-0.5 rounded bg-emerald/15 text-emerald font-mono text-[10px] font-bold border border-emerald/30">HEALTHY</span>`;
          }

          return `
            <div class="glass-card-dark ${glowClass} p-5 rounded-3xl flex flex-col justify-between group cursor-pointer hover:border-white/30 transition-all" data-sku-id="${sku.id}">
              <div>
                <div class="flex items-start justify-between gap-3 mb-3">
                  <div class="flex items-center gap-3">
                    <img src="${sku.img || 'img/jacket.jpg'}" alt="${sku.name}" class="w-12 h-12 rounded-xl object-cover border border-white/10 group-hover:scale-105 transition-transform">
                    <div>
                      <span class="font-mono text-[10px] text-acid font-bold tracking-wider">#${sku.id}</span>
                      <h4 class="font-display font-bold text-sm text-white line-clamp-1">${sku.name}</h4>
                      <span class="text-[11px] text-stucco line-clamp-1">${sku.cat} • ${sku.supplier}</span>
                    </div>
                  </div>
                  ${statusBadge}
                </div>

                <div class="grid grid-cols-2 gap-2 my-3 p-3 rounded-2xl bg-white/[0.03] border border-white/5 font-mono text-xs">
                  <div>
                    <span class="text-[10px] text-stucco block">Stock On Hand</span>
                    <span class="font-bold text-white">${sku.units} units</span>
                  </div>
                  <div>
                    <span class="text-[10px] text-stucco block">Velocity</span>
                    <span class="font-bold text-white">${sku.vel.toFixed(1)}/wk</span>
                  </div>
                  <div>
                    <span class="text-[10px] text-stucco block">Capital Value</span>
                    <span class="font-bold ${isDead ? 'text-crimson' : 'text-white'}">${M.inr(sku.value)}</span>
                  </div>
                  <div>
                    <span class="text-[10px] text-stucco block">Runway</span>
                    <span class="font-bold ${isLow ? 'text-amber' : 'text-white'}">${sku.days.toFixed(0)} days</span>
                  </div>
                </div>
              </div>

              <div class="pt-3 border-t border-white/10 flex items-center justify-between text-xs font-mono">
                <span class="text-stucco text-[11px]">${sku.clearance ? (sku.clearance * 100) + '% Off Live' : 'MRP ' + M.inr(sku.price)}</span>
                <button class="px-3 py-1.5 rounded-xl bg-white/10 hover:bg-acid hover:text-obsidian text-white font-bold transition-colors flex items-center gap-1 open-drawer-btn" data-sku="${sku.id}">
                  <span>Inspect</span>
                  <span class="material-symbols-outlined text-xs">arrow_forward</span>
                </button>
              </div>
            </div>
          `;
        }).join("");

        // Update Pagination Controls
        const paginationStatus = document.getElementById('pagination-status');
        const pageNum = document.getElementById('page-num-display');
        const prevBtn = document.getElementById('prev-page-btn');
        const nextBtn = document.getElementById('next-page-btn');

        if (paginationStatus) paginationStatus.textContent = `Showing ${startIdx + 1}–${Math.min(filtered.length, startIdx + pageSize)} of ${filtered.length} SKUs`;
        if (pageNum) pageNum.textContent = `${currentPage} / ${totalPages}`;
        if (prevBtn) prevBtn.disabled = currentPage <= 1;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

        // Attach Card Click Handlers
        container.querySelectorAll('[data-sku-id]').forEach(card => {
          card.addEventListener('click', (e) => {
            if (e.target.closest('.open-drawer-btn')) return;
            openDrawer(card.getAttribute('data-sku-id'));
          });
        });
        container.querySelectorAll('.open-drawer-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            openDrawer(btn.getAttribute('data-sku'));
          });
        });
      }

      // Drawer Open/Close Logic
      function openDrawer(skuId) {
        const list = M.catalog(actions);
        const sku = list.find(s => s.id === skuId);
        if (!sku) return;
        activeDrawerSku = sku;

        const drawer = document.getElementById('sku-drawer');
        const drawerPanel = drawer.querySelector('.drawer-panel');

        document.getElementById('d-sku-code').textContent = `#${sku.id}`;
        document.getElementById('d-sku-cat').textContent = sku.cat;
        document.getElementById('d-sku-name').textContent = sku.name;
        document.getElementById('d-sku-supplier').textContent = `${sku.supplier} ${sku.phone ? '• ' + sku.phone : ''}`;
        document.getElementById('d-sku-img').src = sku.img || 'img/jacket.jpg';
        document.getElementById('d-sku-units').textContent = `${sku.units} Units`;
        document.getElementById('d-sku-value').textContent = M.inr(sku.value);
        document.getElementById('d-sku-price').textContent = M.inr(sku.price);
        document.getElementById('d-sku-velocity').textContent = `${sku.vel.toFixed(1)} pairs/wk`;

        document.getElementById('d-channel-shopify').textContent = `${sku.channels.shopify || 0} units`;
        document.getElementById('d-channel-pos').textContent = `${sku.channels.pos || 0} units`;
        document.getElementById('d-channel-warehouse').textContent = `${sku.channels.warehouse || 0} units`;

        const pill = document.getElementById('d-sku-status-pill');
        if (sku.status === 'dead') {
          pill.className = "mt-2 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-bold bg-crimson/15 text-crimson border border-crimson/30";
          pill.textContent = "DEAD STOCK (>60 DAYS)";
        } else if (sku.status === 'risk') {
          pill.className = "mt-2 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-bold bg-amber/15 text-amber border border-amber/30";
          pill.textContent = "SLOW MOVING RISK";
        } else if (sku.status === 'low' || sku.status === 'critical') {
          pill.className = "mt-2 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-bold bg-acid/15 text-acid border border-acid/30";
          pill.textContent = `STOCKOUT IN ${sku.days.toFixed(0)} DAYS`;
        } else {
          pill.className = "mt-2 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-bold bg-emerald/15 text-emerald border border-emerald/30";
          pill.textContent = "HEALTHY VELOCITY";
        }

        // AI Note
        const aiNote = document.getElementById('d-sku-ai-note');
        if (sku.status === 'dead' || sku.status === 'risk') {
          aiNote.innerHTML = `Stock has remained inactive for <strong>${sku.age} days</strong>. An immediate <strong>15% clearance promotion</strong> will accelerate sell-through by 3.2x, freeing up <strong>${M.inr(Math.round(sku.value * 0.85))}</strong> in liquid cash.`;
        } else if (sku.status === 'low' || sku.status === 'critical') {
          aiNote.innerHTML = `Coverage runway is only <strong>${sku.days.toFixed(1)} days</strong>. Recommended batch replenishment: <strong>${Math.max(sku.moq || 20, Math.ceil(sku.vel * 30 - sku.units))} units</strong> from ${sku.supplier}.`;
        } else {
          aiNote.innerHTML = `Cadence is balanced. Stock covers approximately <strong>${sku.days.toFixed(0)} days</strong>. No aggressive price action required.`;
        }

        drawer.classList.remove('pointer-events-none', 'opacity-0');
        drawerPanel.classList.remove('translate-x-full');
      }

      function closeDrawer() {
        const drawer = document.getElementById('sku-drawer');
        const drawerPanel = drawer.querySelector('.drawer-panel');
        drawer.classList.add('opacity-0', 'pointer-events-none');
        drawerPanel.classList.add('translate-x-full');
        activeDrawerSku = null;
      }

      document.getElementById('drawer-close-btn').addEventListener('click', closeDrawer);
      document.querySelector('.drawer-backdrop').addEventListener('click', closeDrawer);

      // Drawer Actions
      document.getElementById('d-action-clearance-btn').addEventListener('click', () => {
        if (!activeDrawerSku) return;
        actions.clearance[activeDrawerSku.id] = 0.15;
        persist();
        updateKPIs();
        renderCatalog();
        HapticAudio.success();
        fireConfetti();
        showToast(`⚡ 15% Clearance Promo activated for #${activeDrawerSku.id}!`, "bolt");
        closeDrawer();
      });

      document.getElementById('d-action-reorder-btn').addEventListener('click', () => {
        if (!activeDrawerSku) return;
        const note = M.orderNote(activeDrawerSku);
        if (navigator.clipboard) navigator.clipboard.writeText(note);
        HapticAudio.click(1400);
        showToast(`📋 Supplier PO Note copied to clipboard for ${activeDrawerSku.supplier}`, "content_copy");
        closeDrawer();
      });

      // Card 1 1-Tap Handlers (#JKT-409)
      const jktPromoBtn = document.getElementById('jkt-apply-promo-btn');
      if (jktPromoBtn) {
        jktPromoBtn.addEventListener('click', () => {
          actions.clearance["JKT-409"] = 0.15;
          persist();
          updateKPIs();
          renderCatalog();
          HapticAudio.success();
          fireConfetti();
          showToast("⚡ 15% Clearance Promo activated for #JKT-409 across Shopify & POS! ₹31,000 in recovery.", "bolt");
        });
      }

      const jktLockBtn = document.getElementById('jkt-lock-reorder-btn');
      if (jktLockBtn) {
        jktLockBtn.addEventListener('click', () => {
          actions.locked["JKT-409"] = true;
          persist();
          updateKPIs();
          renderCatalog();
          HapticAudio.click(800);
          showToast("🔒 Reorders locked for Nordic Wear Ltd. Automatic PO halted.", "lock");
        });
      }

      // Card 2 Handlers (#SH-102)
      const shReorderBtn = document.getElementById('sh-reorder-btn');
      if (shReorderBtn) {
        shReorderBtn.addEventListener('click', () => {
          const list = M.catalog(actions);
          const sh = list.find(s => s.id === "SH-102");
          const note = M.orderNote(sh);
          if (navigator.clipboard) navigator.clipboard.writeText(note);
          HapticAudio.success();
          fireConfetti();
          showToast("⚡ 1-Tap Reorder Drafted! PO note copied for Apex Footwear (+91 98201 44821)", "shopping_cart_checkout");
        });
      }

      const shCopyBtn = document.getElementById('sh-copy-note-btn');
      if (shCopyBtn) {
        shCopyBtn.addEventListener('click', () => {
          const list = M.catalog(actions);
          const sh = list.find(s => s.id === "SH-102");
          const note = M.orderNote(sh);
          if (navigator.clipboard) navigator.clipboard.writeText(note);
          HapticAudio.click(1200);
          showToast("📋 Supplier WhatsApp note copied to clipboard!", "content_copy");
        });
      }

      // Card 3 Bundle Handler (#ACC-091)
      const accBundleBtn = document.getElementById('acc-bundle-btn');
      if (accBundleBtn) {
        accBundleBtn.addEventListener('click', () => {
          actions.clearance["ACC-091"] = 0.15;
          actions.clearance["JKT-409"] = 0.15;
          persist();
          updateKPIs();
          renderCatalog();
          HapticAudio.success();
          fireConfetti();
          showToast("⚡ Outerwear & Scarf Bundle Promo Activated! +₹14,200 liquidity targeted.", "join_inner");
        });
      }

      // Working Capital Liquidity Simulator Range Logic
      const simRange = document.getElementById('sim-discount-range');
      const simBadge = document.getElementById('sim-discount-badge');
      const simCash = document.getElementById('sim-cash-recovered');
      const simVel = document.getElementById('sim-velocity-mult');
      const simDays = document.getElementById('sim-days-to-clear');

      if (simRange) {
        simRange.addEventListener('input', (e) => {
          const val = parseInt(e.target.value, 10);
          simBadge.textContent = `${val}%`;
          
          const multiplier = 1 + (val / 100) * 8.5;
          const recovered = Math.round(56200 * (val / 20));
          const days = Math.max(12, Math.round(63 / (1 + val * 0.12)));

          simCash.textContent = M.inr(recovered);
          simVel.textContent = `${multiplier.toFixed(2)}x`;
          simDays.textContent = `${days} Days`;
        });
      }

      const simExecuteBtn = document.getElementById('sim-execute-all-btn');
      if (simExecuteBtn) {
        simExecuteBtn.addEventListener('click', () => {
          const list = M.catalog(actions);
          const deadOrRisk = list.filter(s => s.status === 'dead' || s.status === 'risk');
          deadOrRisk.forEach(s => {
            actions.clearance[s.id] = (parseInt(simRange.value, 10) || 15) / 100;
          });
          persist();
          updateKPIs();
          renderCatalog();
          HapticAudio.success();
          fireConfetti();
          showToast(`⚡ Multi-SKU clearance executed across ${deadOrRisk.length} items!`, "bolt");
        });
      }

      // Channel Selector Pills
      document.querySelectorAll('.terminal-channel-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.terminal-channel-btn').forEach(b => {
            b.className = "terminal-channel-btn px-4 py-2 rounded-xl text-xs font-mono transition-all text-stucco hover:text-white";
          });
          btn.className = "terminal-channel-btn px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all bg-acid text-obsidian shadow-lg";
          currentChannel = btn.getAttribute('data-channel');
          currentPage = 1;
          updateKPIs();
          renderCatalog();
        });
      });

      // Status Filter Chips
      document.querySelectorAll('.status-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          document.querySelectorAll('.status-chip').forEach(c => {
            c.className = "status-chip px-3.5 py-1.5 rounded-xl font-mono text-xs text-stucco hover:text-white bg-white/5";
          });
          chip.className = "status-chip px-3.5 py-1.5 rounded-xl font-mono text-xs font-semibold bg-acid text-obsidian";
          currentStatus = chip.getAttribute('data-status');
          currentPage = 1;
          renderCatalog();
        });
      });

      // Search Input
      const searchInput = document.getElementById('sku-search-input');
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.trim();
          currentPage = 1;
          renderCatalog();
        });
      }

      // Pagination Handlers
      document.getElementById('prev-page-btn').addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          renderCatalog();
        }
      });
      document.getElementById('next-page-btn').addEventListener('click', () => {
        currentPage++;
        renderCatalog();
      });

      // Initial Execution
      updateKPIs();
      renderCatalog();

    })();
  </script>

</body>
</html>