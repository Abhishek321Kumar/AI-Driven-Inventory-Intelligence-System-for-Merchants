      <a href="#ghost-numerals" class="text-stucco hover:text-acid transition-colors">02 // 82% RISK</a>
      <a href="#glass-cards" class="text-stucco hover:text-acid transition-colors">03 // GLASS CARDS</a>
      <a href="#live-terminal" class="text-acid font-semibold hover:text-white transition-colors flex items-center gap-1">
