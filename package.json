{
  "name": "mercura-app",
  "version": "1.0.0",
  "description": "Mercura AI - Local Development Server",
  "scripts": {
    "build:react": "node -e \"const dir = require('fs').existsSync('mercura_ai/src/main.jsx') ? 'mercura_ai' : 'Mercura-App-main'; require('child_process').execSync(`npx esbuild ${dir}/src/main.jsx --bundle --outfile=${dir}/react-mount.js --format=iife --jsx=automatic`, {stdio: 'inherit'})\"",
    "start": "python server.py"
  },
  "dependencies": {
    "esbuild": "0.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
